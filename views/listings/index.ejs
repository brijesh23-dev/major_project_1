<% layout('layouts/boilerplate') %>
    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
        }

        .filter {
            text-align: center;
            margin-top: 2rem;
            margin-right: 2.5rem;
            opacity: 0.7;
        }

        .filter:hover {
            opacity: 1;
        }

        .filter a {
            font-size: 0.8rem;
            text-decoration: none;
            color: black;
        }
    </style>

    <body>
        <div id="filters">
            <div class="filter f1">
                <div><i class="fa-solid fa-fire"></i></div>
                <a href="/listings">All</a>
            </div>
            <div class="filter f2">
                <div><i class="fa-solid fa-bed"></i></div>
                <a href="/listings?category=rooms">Rooms</a>
            </div>
            <div class="filter f3">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <a href="/listings?category=city">City</a>
            </div>
            <div class="filter f4">
                <div><i class="fa-solid fa-mountain"></i></div>
                <a href="/listings?category=mountains">Mountains</a>
            </div>
            <div class="filter f6">
                <div><i class="fa-solid fa-water-ladder"></i></div>
                <a href="/listings?category=beach">Beach</a>
            </div>
            <div class="filter f9">
                <div><i class="fa-solid fa-snowflake"></i></div>
                <a href="/listings?category=arctic">Arctic</a>
            </div>
            <div class="mt-4">
            <form method="GET" action="/listings" >
            <select name="sort" onchange="this.form.submit()" class="form-select">
                  <option value="">Sort By</option>
                  <option value="priceLow">Price: Low to High</option>
                  <option value="priceHigh">Price: High to Low</option>
                  <option value="country">Country A-Z</option>
                  <option value="location">Location A-Z</option>
             </select>
          </form>
            </div>
            <div class="toggle-tax border border-1 border-black  rounded-4 ">
                <div class="form-check form-switch form-check-reverse">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckReverse">
                    <label class="form-check-label" for="switchCheckReverse">Display total after tax</label>
                </div>
            </div>
        </div>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(let listing of allListings){ %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="listing-card col">
                        <img src="<%=listing.image.url %>" class="card-img-top" alt="listing_images"
                            style="height: 20rem;">
                        <!-- <div class="card-img-overlay">abcd</div> -->
                        <div class="card-body">
                            <p class="card-text"><b>
                                    <%= listing.title %>
                                </b><br>
                                &#8377;<%=listing.price.toLocaleString("en-NI") %>/night
                                    &nbsp;&nbsp;&nbsp;<i class="Tax-info">+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                <!-- <p><%= listing.image.url %></p> -->
                <%}%>
        </div>
    </body>

    <script>
        let input = document.querySelector("#switchCheckReverse");
        let taxInfo = document.querySelectorAll('.Tax-info');
        input.addEventListener("change", (e) => {
            for (let info of taxInfo) {
                if (e.target.checked) {
                    info.style.display = 'initial'
                } else {
                    info.style.display = 'none'
                }
            }


        })
    </script>